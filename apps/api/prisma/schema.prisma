generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-tenancy core ────────────────────────────────
model Business {
  id         String    @id @default(uuid())
  name       String
  taxRate    Decimal   @default(0) @db.Decimal(5, 2)
  gcashQrUrl String?
  mayaQrUrl  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  users           User[]
  branches        Branch[]
  categories      Category[]
  products        Product[]
  customers       Customer[]
  sales           Sale[]
  suppliers       Supplier[]
  purchases       Purchase[]
  expenses        Expense[]
  subscription    Subscription?
  idempotencyKeys IdempotencyKey[]
}

// ─── Auth ──────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sales               Sale[]
  expenses            Expense[]
  passwordResetTokens PasswordResetToken[]

  @@index([businessId])
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users       User[]
  inventory   BranchInventory[]
  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]

  @@unique([businessId, name])
  @@index([businessId])
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Categories ────────────────────────────────────────
model Category {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  products   Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

// ─── Products ──────────────────────────────────────────
model Product {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  sku        String
  price      Decimal       @db.Decimal(12, 2)
  cost       Decimal       @default(0) @db.Decimal(12, 2)
  status     ProductStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  inventory     BranchInventory[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, status])
  @@index([categoryId])
}

model BranchInventory {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
}

// ─── Customers ─────────────────────────────────────────
model Customer {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sales         Sale[]

  @@index([businessId])
  @@unique([businessId, phone])
}

// ─── Sales / POS ───────────────────────────────────────
model Sale {
  id               String        @id @default(uuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  amountTendered   Decimal?      @db.Decimal(12, 2)
  changeDue        Decimal?      @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentReference String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  items            SaleItem[]

  @@index([businessId])
  @@index([businessId, paidAt])
  @@index([branchId, paidAt])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
}

// ─── Suppliers ─────────────────────────────────────────
model Supplier {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  contact    String?
  email      String?
  phone      String?
  address    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  purchases  Purchase[]

  @@index([businessId])
}

// ─── Purchases ─────────────────────────────────────────
model Purchase {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  reference  String?
  status     PurchaseStatus @default(PENDING)
  total      Decimal        @db.Decimal(12, 2)
  notes      String?
  orderedAt  DateTime       @default(now())
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  items      PurchaseItem[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([branchId, status])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  sku        String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ─── Expenses ──────────────────────────────────────────
model Expense {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  spentAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([businessId])
  @@index([businessId, spentAt])
  @@index([businessId, category])
  @@index([branchId, spentAt])
}

// ─── Billing ───────────────────────────────────────────
model Subscription {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  autoRenew          Boolean            @default(false)
  providerCustomerId String?
  providerCheckoutId String?
  providerPaymentId  String?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  PENDING
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, processed])
  @@index([createdAt])
}

// ─── Idempotency ───────────────────────────────────────
model IdempotencyKey {
  id         String   @id @default(uuid())
  key        String
  userId     String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endpoint   String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@unique([businessId, key])
  @@index([createdAt])
}